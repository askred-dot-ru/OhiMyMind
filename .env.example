# Host-shaped example (no Compose DNS). Copy to .env and fill secrets.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=postgresql://ohimymind:ohimymind@127.0.0.1:5432/ohimymind
ATTACHMENTS_DIR=./data/attachments
HTTP_HOST=127.0.0.1
HTTP_PORT=8798
PUBLIC_BASE_URL=http://127.0.0.1:8798
APP_MASTER_KEY=
SESSION_SECRET=
OHIMYMIND_BOOTSTRAP_ADMIN=admin
OHIMYMIND_BOOTSTRAP_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Used by docker-compose.yml to create the db service and inject DATABASE_URL.
POSTGRES_USER=ohimymind
POSTGRES_PASSWORD=ohimymind
POSTGRES_DB=ohimymind
